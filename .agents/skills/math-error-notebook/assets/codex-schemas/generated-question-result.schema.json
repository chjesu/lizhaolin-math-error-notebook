{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["complete", "needs_escalation", "unclear"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "escalation_reasons": {"type": "array", "items": {"type": "string"}},
    "payload": {
      "type": "object",
      "properties": {
        "schema": {"type": "string", "const": "math-generated-question-candidate/v1"},
        "verification_status": {"type": "string", "const": "unverified"},
        "stem": {"type": "string"},
        "options": {"type": ["array", "null"], "items": {"type": "string"}},
        "answer": {"type": "string"},
        "solution": {"type": "string"},
        "grade": {"type": "integer", "enum": [10, 11, 12]},
        "difficulty": {"type": "number", "minimum": 1, "maximum": 5},
        "question_type": {"type": "string"},
        "knowledge_codes": {"type": "array", "items": {"type": "string"}},
        "target_causes": {"type": "array", "items": {"type": "string"}},
        "feature_codes": {"type": "array", "items": {"type": "string"}},
        "source_name": {"type": "string", "const": "model-generated-unverified"}
      },
      "required": ["schema", "verification_status", "stem", "options", "answer", "solution", "grade", "difficulty", "question_type", "knowledge_codes", "target_causes", "feature_codes", "source_name"],
      "additionalProperties": false
    }
  },
  "required": ["status", "confidence", "escalation_reasons", "payload"],
  "additionalProperties": false
}
