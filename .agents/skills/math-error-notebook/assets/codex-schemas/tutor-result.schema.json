{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["complete", "needs_escalation", "unclear"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "escalation_reasons": {"type": "array", "items": {"type": "string"}},
    "payload": {
      "type": "object",
      "properties": {
        "diagnosis_summary": {"type": "string"},
        "socratic_questions": {"type": "array", "items": {"type": "string"}},
        "progressive_hints": {"type": "array", "items": {"type": "string"}},
        "next_step": {"type": "string"}
      },
      "required": ["diagnosis_summary", "socratic_questions", "progressive_hints", "next_step"],
      "additionalProperties": false
    }
  },
  "required": ["status", "confidence", "escalation_reasons", "payload"],
  "additionalProperties": false
}
