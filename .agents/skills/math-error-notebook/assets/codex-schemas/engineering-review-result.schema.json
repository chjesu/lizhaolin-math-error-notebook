{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["complete", "needs_escalation", "unclear"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "escalation_reasons": {"type": "array", "items": {"type": "string"}},
    "payload": {
      "type": "object",
      "properties": {
        "schema": {"type": "string", "const": "web-engineering-review/v1"},
        "decision": {"type": "string", "enum": ["pass", "changes_required", "blocked"]},
        "summary": {"type": "string"},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
              "category": {"type": "string"},
              "file": {"type": ["string", "null"]},
              "line": {"type": ["integer", "null"], "minimum": 1},
              "issue": {"type": "string"},
              "evidence": {"type": "string"},
              "recommendation": {"type": "string"}
            },
            "required": ["severity", "category", "file", "line", "issue", "evidence", "recommendation"],
            "additionalProperties": false
          }
        },
        "tests_to_add": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "database_modified": {"type": "boolean", "const": false}
      },
      "required": ["schema", "decision", "summary", "findings", "tests_to_add", "confidence", "database_modified"],
      "additionalProperties": false
    }
  },
  "required": ["status", "confidence", "escalation_reasons", "payload"],
  "additionalProperties": false
}
