{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["complete", "needs_escalation", "unclear"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "escalation_reasons": {"type": "array", "items": {"type": "string"}},
    "payload": {
      "type": "object",
      "properties": {
        "verdict": {"type": "string", "enum": ["correct", "wrong", "partial", "unclear"]},
        "key_verification": {"type": "string"},
        "error_analysis": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "properties": {
                "problem_text": {"type": "string"},
                "student_answer": {"type": "string"},
                "correct_answer": {"type": "string"},
                "correct_solution": {"type": "string"},
                "first_wrong_step": {"type": "string"},
                "cause_code": {"type": "string", "enum": ["knowledge_gap", "concept_confusion", "formula_condition", "method_choice", "reasoning_gap", "algebra_transform", "calculation", "misreading", "incomplete_cases", "expression", "careless", "unclear"]},
                "cause_detail": {"type": "string"},
                "evidence": {"type": "array", "items": {"type": "string"}},
                "knowledge_codes": {"type": "array", "items": {"type": "string"}},
                "feature_codes": {"type": "array", "items": {"type": "string"}},
                "question_type": {"type": "string"},
                "difficulty": {"type": "number", "minimum": 1, "maximum": 5},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "image_path": {"type": ["string", "null"]},
                "question_id": {"type": ["string", "null"]}
              },
              "required": ["problem_text", "student_answer", "correct_answer", "correct_solution", "first_wrong_step", "cause_code", "cause_detail", "evidence", "knowledge_codes", "feature_codes", "question_type", "difficulty", "confidence", "image_path", "question_id"],
              "additionalProperties": false
            }
          ]
        },
        "next_step": {"type": "string"}
      },
      "required": ["verdict", "key_verification", "error_analysis", "next_step"],
      "additionalProperties": false
    }
  },
  "required": ["status", "confidence", "escalation_reasons", "payload"],
  "additionalProperties": false
}
